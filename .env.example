# Copier vers .env.local — jamais de vraies clés dans Git.

NODE_ENV=development

# Domaine public réel (sert au sitemap, robots.txt, et aux liens envoyés
# par email). Sans ça, on retombe sur le domaine Vercel par défaut.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth ---

# Secret de signature des cookies membres (connexion, session /app).
# Recommandé distinct de ADMIN_SECRET : si l'un fuite, l'autre reste sûr.
# Si absent, retombe sur ADMIN_SECRET.
AUTH_SECRET=

# Mot de passe portail admin (12+ caractères). Aussi dans Vercel Production.
ADMIN_SECRET=

# Chemin secret du back-office (ex: /backoffice-x7f2). /admin reste
# toujours bloqué (404) quel que soit le réglage — jamais en clair.
ADMIN_PATH=

# --- Données ---

# Persistance réelle (Neon / Vercel Postgres). Sans ça, les publications
# se perdent au redeploy (store en mémoire).
DATABASE_URL=

# --- Automatisation ---

# Autorise l'appel du cron quotidien /api/cron/pronos (Bearer ou ?secret=).
# Si absent, retombe sur ADMIN_SECRET.
CRON_SECRET=

# --- Email (mot de passe oublié) ---

# Active l'envoi réel via l'API Resend. Sans clé, le lien de
# réinitialisation s'affiche directement sur la page (repli assumé).
RESEND_API_KEY=
MAIL_FROM="XWIN <onboarding@resend.dev>"

# --- Paiement montantes — plus tard ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
