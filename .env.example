# Copier vers .env.local — jamais de vraies clés dans Git.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mot de passe portail /admin (12+ caractères). Aussi dans Vercel Production.
ADMIN_SECRET=

# Persistance réelle (Neon / Vercel Postgres). Sans ça, les publications se perdent au redeploy.
DATABASE_URL=

